# ---------------------------------------------------------------
# Sanity (safe to expose — read-only public dataset)
# ---------------------------------------------------------------
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-10-01

# Public site URL (used for canonical + Open Graph URLs)
VITE_SITE_URL=https://www.anrcas.edu.in

# ---------------------------------------------------------------
# SERVER ONLY — never prefix these with VITE_, never import them
# into any file under src/. They are read exclusively by /api/*.
# ---------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM="ANR College Website <website@anrcas.edu.in>"
MAIL_TO=admin@anrcas.edu.in
